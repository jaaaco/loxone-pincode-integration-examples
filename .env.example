# Skopiuj do .env.local i uzupełnij. .env.local jest w .gitignore — nie commituj.
#   cp .env.example .env.local && source .env.local

# CloudDNS base = https://dns.loxonecloud.com/<NUMER-SERYJNY-MINISERVERA>
# Numer seryjny = MAC Miniservera bez dwukropków, np. AABBCCDDEEFF
export SERVER_BASE="https://dns.loxonecloud.com/AABBCCDDEEFF"

# Konto serwisowe (NIE admin) z prawem zarządzania użytkownikami i kodami.
export AUTH="serwis:twoje-haslo"

# Opcjonalnie: adres Miniservera resolwowany z CloudDNS (307).
# Zmienia się po restarcie — zwykle zostaw puste, skrypty resolwują na żywo:
#   ./examples/bash/pin_workflow.sh resolve
# export TARGET_BASE="https://203-0-113-42.AABBCCDDEEFF.dyndns.loxonecloud.com:37868"
